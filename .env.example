# ==============================================================================
# VEYORA SaaS Environment Variables Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB)
# Provide your MongoDB Atlas or local MongoDB connection URI:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/veyora?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=veyora_secure_jwt_access_token_secret_2026_change_in_production
JWT_REFRESH_SECRET=veyora_secure_jwt_refresh_token_secret_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend API Configuration
VITE_API_URL=/api/v1

# AI Studio Optional Integration
GEMINI_API_KEY=
APP_URL=

